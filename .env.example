# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
# demo renders the site but NEVER saves requests. Set live after MySQL setup.
APP_MODE=demo
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=dinas_laundry
MYSQL_USER=dinas_app
MYSQL_PASSWORD=replace-with-your-database-password
# For a remote MySQL server, use a trusted CA file (enables identity verification).
MYSQL_SSL_CA=
SESSION_COOKIE_SECURE=false
# Change these only when the shop confirms its rates. They remain sample rates.
RATE_WASH_FOLD=65.00
RATE_IRONING=80.00
RATE_BEDDING=100.00
